{% raw %}# Runs the static checks (formatting, lint, types) once, the tests on Linux, macOS and Windows
# with the oldest and newest Python supported, and a coverage report once: once per pull request
# (on the merge GitHub would make), and on whatever lands on main.
name: check

on:
  push:
    branches: [main]
  pull_request:

permissions:
  contents: read

# A new push cancels the branch's run still going, which no longer says anything about the
# branch and holds runners the new one needs (an account runs only so many jobs at once). On
# main too: merging a stack pushes several commits at once, and only the newest one's run
# matters when a ruleset requires "CI passed" before merging (setup-github-repo sets one).
# A re-run cancels no running run, so re-running an older commit's run waits for the newest's
# (though, like any queued run, it replaces another one waiting in the group).
concurrency:
  group: check-${{ github.ref }}
  cancel-in-progress: ${{ github.run_attempt == 1 }}

# Each job's time limit (timeout-minutes) is about 20% over how long it takes, so a hung job
# fails soon. If a job runs into it, speed it up if you can, and only then raise the limit (see
# AGENTS.md).
jobs:
  # Whether anything but docs changed. A pull request touching only Markdown skips the checks
  # (CI passed still reports); main always runs them.
  changes:
    runs-on: ubuntu-latest
    timeout-minutes: 1
    outputs:
      code: ${{ steps.diff.outputs.code }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
          fetch-depth: 2  # the merge GitHub would make, and its first parent: the base
      - id: diff
        env:
          EVENT: ${{ github.event_name }}
        run: |
          set -eu
          if [ "$EVENT" != pull_request ]; then
            echo "code=true" >> "$GITHUB_OUTPUT"
            exit 0
          fi
          # Its own line, so a failing diff fails the step rather than reading as no code.
          files=$(git diff --name-only --no-renames HEAD^1 HEAD)
          if printf '%s\n' "$files" | grep -vE '\.md$' | grep -q .; then
            echo "code=true" >> "$GITHUB_OUTPUT"
          else
            echo "code=false" >> "$GITHUB_OUTPUT"
          fi

  # Formatting, lint and types are the same on every system: once, on Linux.
  static:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
        with:
          enable-cache: false
          # The oldest Python supported, which basedpyright checks for too.
{% endraw %}          python-version: "{{ min_python }}"
{% raw %}      # Through uv: the runner's own `python` may be older than the one uv provides, and
      # dev.py stops under a Python older than the package needs. dev.py installs from
      # uv.lock, and in CI fails if it's out of date.
      - run: uv run --no-project python dev.py static

  # The tests, on every system, with the oldest and newest Python.
  tests:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    timeout-minutes: 10
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
{% endraw %}        python: ["{{ min_python }}", "{{ newest_python }}"]
{% raw %}    name: ${{ matrix.os }}, Python ${{ matrix.python }}
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
        with:
          enable-cache: false
          python-version: ${{ matrix.python }}
      - run: uv run --no-project python dev.py tests

  # What the tests run, once, on Linux with the newest Python: each file's lines and branches
  # they don't, in the job's summary. A report rather than a check until pyproject.toml's
  # [tool.coverage.report] sets fail_under, below which this job, and so CI, fails.
  coverage:
    needs: changes
    if: needs.changes.outputs.code == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1  # v7.0.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2  # v10.3.3
        with:
          enable-cache: false
{% endraw %}          python-version: "{{ newest_python }}"
{% raw %}      - run: uv run --no-project python dev.py coverage
      # Also when the tests failed or fell short of fail_under, unless there's nothing to report;
      # the step above already failed for a shortfall, so this one doesn't again.
      - name: Put the coverage report in the job's summary
        if: ${{ !cancelled() && hashFiles('.coverage') != '' }}
        run: .venv/bin/coverage report --format=markdown --fail-under=0 >> "$GITHUB_STEP_SUMMARY"

  # The one check a ruleset on main should require, so changing the jobs doesn't change what's
  # required. It runs even if a check failed (a skipped required check would count as
  # passing), and fails unless every check passed, or docs alone changed.
  passed:
    name: CI passed
    if: always()
    needs: [changes, static, tests, coverage]
    runs-on: ubuntu-latest
    timeout-minutes: 2  # time for the force-cancel step's minute, below
    permissions:
      actions: write
    steps:
      # A cancelled run still runs this job, because of always(). Cancelling it too, which only
      # force-cancel can, marks it cancelled rather than failed, which blocks a merge just the
      # same. (A fork's pull request can't, so there it fails.) The next step doesn't run in a
      # cancelled run, so if the force-cancel hasn't stopped this job within a minute, fail.
      - name: Cancel this job if the run was cancelled
        if: cancelled()
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          gh api --method POST "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/force-cancel"
          sleep 60
          exit 1
      - name: Fail unless every check passed
        env:
          CHANGES: ${{ needs.changes.result }}
          CODE: ${{ needs.changes.outputs.code }}
          STATIC: ${{ needs.static.result }}
          TESTS: ${{ needs.tests.result }}
          COVERAGE: ${{ needs.coverage.result }}
        run: |
          [ "$CHANGES" = success ] || exit 1
          [ "$CODE" = false ] && exit 0
          [ "$STATIC" = success ] && [ "$TESTS" = success ] && [ "$COVERAGE" = success ]
{% endraw %}