[project]
name = "{{ project_name }}"
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
license = "MIT"
license-files = ["LICENSE"]
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
requires-python = ">={{ min_python }}"
dependencies = []

[project.scripts]
{{ project_name }} = "{{ package_name }}.cli:main"

[dependency-groups]
# The template's dev tools, kept current by `copier update`; the project's own go in `dev`
# (`uv add --dev`), so the two never conflict.
template-dev = [
    "basedpyright>=1.40.2",
    "coverage>=7.17.3",
    "pytest>=9.2.0",
    "pytest-xdist>=3.8.0",
    "ruff>=0.17.5",
]
dev = [{ include-group = "template-dev" }]

[build-system]
requires = ["hatchling>=1.33.0"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest]
testpaths = ["tests"]
# One worker per CPU (pytest-xdist); `-n 0` runs them one at a time, e.g. to debug.
addopts = ["--numprocesses", "auto"]

[tool.ruff]
line-length = 100
target-version = "py{{ min_python | replace('.', '') }}"
# dev.py runs under an older Python too, to say it's too old: keep it to syntax that parses there.
per-file-target-version = { "dev.py" = "py311" }

[tool.ruff.lint]
extend-select = [
    "I",
    "UP",
    "B",
    "C4",
    "SIM",
    # The project's own below:
]

[tool.basedpyright]
include = [
    "src",
    "tests",
    "dev.py",
    # The project's own below:
]
typeCheckingMode = "strict"
pythonVersion = "{{ min_python }}"

[tool.coverage.run]
source = ["{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
skip_covered = true
